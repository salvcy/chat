{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dial",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 3000
    },
    {
      "name": "worker",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd web && exec npx wrangler dev --port 8787 --local"],
      "port": 8787
    }
  ]
}
